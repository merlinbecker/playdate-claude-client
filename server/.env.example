# Kopieren nach .env und anpassen. .env wird nicht eingecheckt.

# Gerätetoken, muss im Playdate-Client (playdate/source/config.lua) gleich sein
PDC_TOKEN=bitte-aendern

# Datenverzeichnis für Aufnahmen, Datenbank, Assets
PDC_DATA=./data

# echo = Testagent ohne Claude, claude = Claude Code im Headless-Modus
PDC_AGENT=echo

# Arbeitsverzeichnis des Agenten (z. B. ein Repo oder ein Ordner mit eigener CLAUDE.md)
PDC_AGENT_DIR=~/assistant

# Datei mit zusätzlichen Anweisungen für den Agenten (liegt außerhalb des Repos)
PDC_AGENT_PROMPT=./agent_prompt.example.md

# faster-whisper | whisper-cli | none
PDC_STT=faster-whisper
PDC_WHISPER_MODEL=small
PDC_LANG=de
