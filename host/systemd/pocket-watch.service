# Weckt Rollen-Sitzungen bei neuen Aufträgen in ihrer Inbox und pausiert bei leerer Quota.
# Eigene Einstellungen (NUDGE_INTERVAL, LIMIT_BACKOFF, ...) optional in /etc/pocket-concierge/watch.env

[Unit]
Description=Pocket Concierge Inbox-Watcher
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=@USER@
WorkingDirectory=~
EnvironmentFile=/etc/pocket-concierge/pocket-concierge.env
EnvironmentFile=-/etc/pocket-concierge/watch.env
ExecStart=/usr/local/bin/pocket-watch
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
