# Eine Rollen-Sitzung (Claude Code mit Remote Control) in einer eigenen tmux-Sitzung.
# Instanzname = Rolle, z. B. pocket-role@concierge.service
# Anhängen: tmux -L pocket-<rolle> attach

[Unit]
Description=Pocket-Concierge-Rolle %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=forking
User=@USER@
WorkingDirectory=~
Environment=TERM=xterm-256color
ExecStart=/usr/bin/tmux -L pocket-%i new-session -d -s %i -x 200 -y 50 /usr/local/bin/pocket-run %i
ExecStop=/usr/bin/tmux -L pocket-%i kill-server
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
